---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

// Página escondida de prueba: no se enlaza desde ningún lado ni va en el sitemap.
const productos = [
  { id: 'qrescueid-fisico', nombre: 'QRescueID Físico', precio: 19990 },
  { id: 'kit-premium', nombre: 'Kit Premium', precio: 36990 },
];

const regiones = [
  'Arica y Parinacota',
  'Tarapacá',
  'Antofagasta',
  'Atacama',
  'Coquimbo',
  'Valparaíso',
  'Metropolitana de Santiago',
  "Libertador General Bernardo O'Higgins",
  'Maule',
  'Ñuble',
  'Biobío',
  'La Araucanía',
  'Los Ríos',
  'Los Lagos',
  'Aysén del General Carlos Ibáñez del Campo',
  'Magallanes y de la Antártica Chilena',
];
---

<BaseLayout
  title="Comprar - QRescueID"
  description="Compra tu QRescueID."
  noindex
>
  <Navbar />

  <section class="contact-hero-section py-5">
    <div class="container">
      <div class="row">
        <div class="col-lg-8 mx-auto py-lg-5 mt-lg-5">
          <h1 class="display-5 fw-bold mb-3 mt-4 mt-lg-0">Comprar</h1>
          <p class="text-muted mb-0">Despacho solo dentro de Chile</p>
        </div>
      </div>
    </div>
  </section>

  <section class="contact-form-section pt-0">
    <div class="container">
      <div class="row">
        <div class="col-lg-8 mx-auto">

          <div id="sinTienda" class="contact-form-container text-center">
            <p class="lead mb-4">La tienda en línea todavía no está disponible.</p>
            <a href="/tienda/" class="btn btn-primary-yellow">Volver a la tienda</a>
          </div>

          <form id="checkoutForm" class="contact-form contact-form-container d-none" novalidate>

            <h2 class="h4 fw-bold mb-3">Producto</h2>
            {productos.map((p, i) => (
              <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="producto" id={`p-${p.id}`} value={p.id}
                  data-precio={p.precio} checked={i === 0} required />
                <label class="form-check-label" for={`p-${p.id}`}>
                  {p.nombre} - ${p.precio.toLocaleString('es-CL')}
                </label>
              </div>
            ))}

            <div class="mt-3 mb-4" style="max-width: 10rem;">
              <label class="form-label" for="cantidad">Cantidad</label>
              <select class="form-select" id="cantidad" name="cantidad" required>
                {[1, 2, 3, 4, 5].map(n => <option value={n}>{n}</option>)}
              </select>
            </div>

            <div class="mb-4">
              <div class="d-flex justify-content-between"><span>Subtotal</span><span id="subtotal"></span></div>
              <div class="d-flex justify-content-between fw-bold fs-5 mt-2"><span>Total</span><span id="total"></span></div>
              <p class="small text-muted mt-2 mb-0">Despacho solo dentro de Chile</p>
            </div>

            <hr />

            <h2 class="h4 fw-bold mt-4 mb-3">Tus datos</h2>
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label" for="nombre">Nombre</label>
                <input class="form-control" id="nombre" name="nombre" type="text" autocomplete="name" required maxlength="120" />
              </div>
              <div class="col-md-6">
                <label class="form-label" for="correo">Correo</label>
                <input class="form-control" id="correo" name="correo" type="email" autocomplete="email" required minlength="3" maxlength="254" />
              </div>
              <div class="col-md-6">
                <label class="form-label" for="telefono">Teléfono</label>
                <input class="form-control" id="telefono" name="telefono" type="tel" autocomplete="tel" required
                  minlength="6" maxlength="20" pattern={String.raw`\+?[0-9 \(\)\-]{6,20}`} placeholder="+56 9 1234 5678" />
              </div>
              <div class="col-md-6">
                <label class="form-label" for="rut">RUT (opcional)</label>
                <input class="form-control" id="rut" name="rut" type="text" maxlength="12" placeholder="12.345.678-9" />
              </div>
            </div>

            <h2 class="h4 fw-bold mt-5 mb-3">Despacho</h2>
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label" for="region">Región</label>
                <select class="form-select" id="region" name="region" autocomplete="address-level1" required>
                  <option value="">Elige tu región</option>
                  {regiones.map(r => <option value={r}>{r}</option>)}
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label" for="comuna">Comuna</label>
                <input class="form-control" id="comuna" name="comuna" type="text" autocomplete="address-level2" required maxlength="80" />
              </div>
              <div class="col-12">
                <label class="form-label" for="direccion">Dirección</label>
                <input class="form-control" id="direccion" name="direccion" type="text" autocomplete="street-address" required maxlength="200"
                  placeholder="Calle, número, depto" />
              </div>
              <div class="col-12">
                <label class="form-label" for="indicaciones">Indicaciones (opcional)</label>
                <textarea class="form-control" id="indicaciones" name="indicaciones" maxlength="500" rows="3"
                  style="min-height: 0;"></textarea>
              </div>
            </div>

            <div class="form-check mt-4">
              <input class="form-check-input" type="checkbox" id="acepto" name="acepto" required />
              <label class="form-check-label" for="acepto">
                Acepto los <a href="/terminos/" target="_blank" rel="noopener">Términos y condiciones</a> y la
                <a href="/privacidad/" target="_blank" rel="noopener">Política de privacidad</a>
              </label>
            </div>

            <h2 class="h4 fw-bold mt-5 mb-3">Pago</h2>
            <div class="form-check mb-2">
              <input class="form-check-input" type="radio" name="medio" id="medio-webpay" value="webpay" checked required />
              <label class="form-check-label" for="medio-webpay">Webpay (tarjetas de crédito, débito y prepago)</label>
            </div>
            <div class="form-check mb-2">
              <input class="form-check-input" type="radio" name="medio" id="medio-mercadopago" value="mercadopago" required />
              <label class="form-check-label" for="medio-mercadopago">Mercado Pago</label>
            </div>

            <div id="turnstile"></div>

            <div id="aviso" class="alert alert-danger mt-4 d-none" role="alert"></div>

            <div class="mt-4 text-center">
              <button type="submit" id="pagar" class="btn btn-primary-yellow btn-lg">Pagar con Webpay</button>
            </div>
          </form>

        </div>
      </div>
    </div>
  </section>

  <style>
    .contact-form .form-select {
      background-color: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: var(--white);
      padding: 0.75rem 1rem;
      border-radius: 8px;
    }
    .contact-form .form-select option { color: #000; }
    .contact-form .form-check-label a { color: var(--golden-yellow); }
  </style>

  <Footer />

  <Fragment slot="body-end">
    <script is:inline>
      (function () {
        var API = 'https://byzjsuxbdmbmvwoagujg.supabase.co/functions/v1/tienda-crear-pedido';
        var SITEKEY = '0x4AAAAAADt7NVt_5oppicP0';
        var WEBPAY_HOSTS = ['webpay3gint.transbank.cl', 'webpay3g.transbank.cl'];
        var MP_HOSTS = ['www.mercadopago.cl', 'sandbox.mercadopago.cl', 'www.mercadopago.com', 'sandbox.mercadopago.com'];
        var NOMBRES = { webpay: 'Webpay', mercadopago: 'Mercado Pago' };

        // La llave de vista previa llega en el fragmento (#k=...), que nunca viaja al servidor.
        var llave = new URLSearchParams(location.hash.slice(1)).get('k');
        try {
          if (llave) sessionStorage.setItem('tiendaPreview', llave);
          else llave = sessionStorage.getItem('tiendaPreview');
        } catch (e) {}
        if (location.hash) history.replaceState(null, '', location.pathname + location.search);
        if (!llave) return;

        var form = document.getElementById('checkoutForm');
        var boton = document.getElementById('pagar');
        var aviso = document.getElementById('aviso');
        document.getElementById('sinTienda').classList.add('d-none');
        form.classList.remove('d-none');

        // Preselección por ?p=
        var p = new URLSearchParams(location.search).get('p');
        var radio = p && document.getElementById('p-' + p);
        if (radio && radio.name === 'producto') radio.checked = true;

        function pesos(n) { return '$' + n.toLocaleString('es-CL'); }
        function actualizarResumen() {
          var sel = form.querySelector('input[name="producto"]:checked');
          var total = Number(sel.dataset.precio) * Number(form.cantidad.value);
          document.getElementById('subtotal').textContent = pesos(total);
          document.getElementById('total').textContent = pesos(total);
        }
        form.addEventListener('change', actualizarResumen);
        actualizarResumen();

        function medio() { return form.querySelector('input[name="medio"]:checked').value; }
        function textoBoton() { return 'Pagar con ' + NOMBRES[medio()]; }
        form.addEventListener('change', function () { if (!enviando) boton.textContent = textoBoton(); });
        boton.textContent = textoBoton();

        // Turnstile invisible: se renderiza al cargar y se ejecuta recién al pagar.
        var widgetId = null;
        var pendiente = null;
        window.onTurnstileLoad = function () {
          widgetId = turnstile.render('#turnstile', {
            sitekey: SITEKEY,
            execution: 'execute',
            callback: function (token) { if (pendiente) { pendiente.resolve(token); pendiente = null; } },
            'error-callback': function () { if (pendiente) { pendiente.reject(); pendiente = null; } },
            'expired-callback': function () { turnstile.reset(widgetId); },
          });
        };
        var s = document.createElement('script');
        s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onTurnstileLoad';
        s.async = true;
        document.head.appendChild(s);

        function pedirToken() {
          return new Promise(function (resolve, reject) {
            if (widgetId === null) return reject();
            pendiente = { resolve: resolve, reject: reject };
            turnstile.execute(widgetId);
          });
        }

        function mostrarError(msg) {
          aviso.textContent = msg;
          aviso.classList.remove('d-none');
          boton.disabled = false;
          boton.textContent = textoBoton();
          if (widgetId !== null) turnstile.reset(widgetId);
        }

        var enviando = false;
        // Si vuelve desde Webpay con el botón atrás, el navegador restaura la página tal cual: reactivamos el botón.
        window.addEventListener('pageshow', function (e) {
          if (e.persisted) { enviando = false; boton.disabled = false; boton.textContent = textoBoton(); }
        });
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          if (enviando) return;
          aviso.classList.add('d-none');

          var v = function (name) { return form[name].value.trim(); };
          var obligatorios = ['nombre', 'correo', 'telefono', 'region', 'comuna', 'direccion'];
          if (!form.checkValidity() || obligatorios.some(function (n) { return !v(n); })) {
            form.reportValidity();
            aviso.textContent = 'Revisa que todos los datos estén completos.';
            aviso.classList.remove('d-none');
            return;
          }

          var provider = medio();
          enviando = true;
          boton.disabled = true;
          boton.textContent = 'Conectando con ' + NOMBRES[provider] + '…';

          var buyer = { name: v('nombre'), email: v('correo'), phone: v('telefono') };
          if (v('rut')) buyer.rut = v('rut');
          var shipping = { region: v('region'), comuna: v('comuna'), address: v('direccion') };
          if (v('indicaciones')) shipping.notes = v('indicaciones');

          pedirToken()
            .catch(function () { throw new Error('No pudimos verificar que no eres un robot. Intenta de nuevo.'); })
            .then(function (token) {
              return fetch(API, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'x-store-preview': llave },
                body: JSON.stringify({
                  items: [{ product_id: form.querySelector('input[name="producto"]:checked').value, quantity: Number(form.cantidad.value) }],
                  buyer: buyer,
                  shipping: shipping,
                  provider: provider,
                  captcha_token: token,
                }),
              }).catch(function () { throw new Error('No pudimos conectarnos. Revisa tu conexión e intenta de nuevo.'); });
            })
            .then(function (res) {
              return res.json().catch(function () { return {}; }).then(function (data) {
                if (!res.ok) throw new Error(data.error || 'No pudimos crear tu pedido. Intenta de nuevo.');
                var destino;
                try { destino = new URL(data.url); } catch (e) {}
                if (provider === 'mercadopago') {
                  if (!destino || destino.protocol !== 'https:' || MP_HOSTS.indexOf(destino.hostname) === -1) {
                    throw new Error('No pudimos conectar con Mercado Pago. Intenta de nuevo.');
                  }
                  location.assign(destino.href);
                  return;
                }
                if (!destino || destino.protocol !== 'https:' || WEBPAY_HOSTS.indexOf(destino.hostname) === -1 || !data.token) {
                  throw new Error('No pudimos conectar con Webpay. Intenta de nuevo.');
                }
                var f = document.createElement('form');
                f.method = 'POST';
                f.action = destino.href;
                var campo = document.createElement('input');
                campo.type = 'hidden';
                campo.name = 'token_ws';
                campo.value = data.token;
                f.appendChild(campo);
                document.body.appendChild(f);
                f.submit();
              });
            })
            .catch(function (err) {
              enviando = false;
              mostrarError(err.message);
            });
        });
      })();
    </script>
  </Fragment>
</BaseLayout>
